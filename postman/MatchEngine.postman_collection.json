    {
      "name": "4. Trading demo (run \"npm run db:reset:demo\" first)",
      "item": [
        {
          "name": "Alice places BUY 10 ITC @ 100.00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "description": "No seller exists yet, so this order rests on the book.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"ITC\",\n  \"side\": \"buy\",\n  \"price\": \"100.00\",\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Order accepted and saved', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.order.side).to.eql('buy');",
                  "  pm.collectionVariables.set('aliceOrderId', body.order.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bob places SELL 6 ITC @ 100.00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "description": "Matches the resting buy. Bob is fully filled.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"ITC\",\n  \"side\": \"sell\",\n  \"price\": \"100.00\",\n  \"quantity\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Bob traded 6 shares in total at 100.00', function () {",
                  "  const body = pm.response.json();",
                  "  const total = body.trades.reduce(function (sum, t) { return sum + t.quantity; }, 0);",
                  "  pm.expect(total).to.eql(6);",
                  "  body.trades.forEach(function (t) { pm.expect(t.price).to.eql('100.00'); });",
                  "  pm.expect(body.order.status).to.eql('filled');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Order book after the trade (ITC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orderbook/ITC",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Alice's leftover buy is still on the book\", function () {",
                  "  pm.expect(pm.response.json().bids.length).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Alice's order (partly filled)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{aliceOrderId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order is open or partial, with a sensible remaining quantity', function () {",
                  "  const order = pm.response.json().order;",
                  "  pm.expect(['open', 'partial']).to.include(order.status);",
                  "  pm.expect(order.remainingQuantity).to.be.within(1, 10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Alice's order list",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders?symbol=ITC",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Orders list is not empty', function () { pm.expect(pm.response.json().orders.length).to.be.at.least(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Trade tape (ITC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/trades/ITC?limit=20",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('At least one trade exists', function () { pm.expect(pm.response.json().trades.length).to.be.at.least(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Alice tries to SELL into her own buy (self-trade)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "description": "Refused: the order would trade against Alice's own resting buy.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"ITC\",\n  \"side\": \"sell\",\n  \"price\": \"100.00\",\n  \"quantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error code is SELF_TRADE', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('SELF_TRADE');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
