{
  "info": {
    "name": "MatchEngine API",
    "description": "Demonstration of every MatchEngine endpoint.\n\nHow to use: start the backend (npm run dev in backend), run \"npm run db:reset:demo\" for a clean order book, then run this collection with the Collection Runner. Run the folders in order: later requests use tokens and ids saved by earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public (no login needed)",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Server says ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List securities",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/securities",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('At least 5 securities', function () {",
                  "  pm.expect(pm.response.json().securities.length).to.be.at.least(5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "One security (TCS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/securities/TCS",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Symbol is TCS', function () { pm.expect(pm.response.json().security.symbol).to.eql('TCS'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Order book (ITC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orderbook/ITC",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has bids and asks lists', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.bids).to.be.an('array');",
                  "  pm.expect(body.asks).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Recent trades (ITC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/trades/ITC?limit=20",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has a trades list', function () { pm.expect(pm.response.json().trades).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Register and log in",
      "item": [
        {
          "name": "Register a new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newEmail}}\",\n  \"fullName\": \"Postman Tester\",\n  \"password\": \"postman12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newEmail', 'postman_' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('A token is returned', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string');",
                  "  pm.collectionVariables.set('newToken', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Token saved as aliceToken', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string');",
                  "  pm.collectionVariables.set('aliceToken', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Token saved as bobToken', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string');",
                  "  pm.collectionVariables.set('bobToken', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (Alice)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('It is Alice', function () {",
                  "  pm.expect(pm.response.json().user.email).to.eql('alice@example.com');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Account (login needed)",
      "item": [
        {
          "name": "My balance (Alice)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/account",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Money is text with 2 decimals', function () {",
                  "  const account = pm.response.json().account;",
                  "  pm.expect(account.cashBalance).to.match(/^\\d+\\.\\d{2}$/);",
                  "  pm.expect(account.availableBalance).to.match(/^\\d+\\.\\d{2}$/);",
                  "});"
                ]
              }
            }
          ]
        },
